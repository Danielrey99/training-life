# Copia este archivo a `.env` (dentro de web/) solo si la API no está en
# http://localhost:8000 (por ejemplo, si el backend corre en otro puerto u otra máquina).
#
# Sin este archivo, la web usa http://localhost:8000, que es lo que hace falta
# cuando desarrollas en el mismo ordenador que el backend.

VITE_API_URL=http://192.168.1.100:8000
