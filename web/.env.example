# Copia este archivo a `.env` (dentro de web/) solo si necesitas apuntar a otra
# dirección: por ejemplo, para abrir la web desde el móvil en la WiFi de casa,
# donde "localhost" ya no es el PC que sirve la API.
#
# Sin este archivo, la web usa http://localhost:8000, que es lo que hace falta
# cuando desarrollas en el mismo ordenador que el backend.

VITE_API_URL=http://192.168.1.100:8000
