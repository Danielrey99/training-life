# Copia este archivo a backend/.env si vas a ejecutar el backend o Alembic
# FUERA de Docker (con un venv local). Debe apuntar al puerto publicado en el
# host (5433), no al puerto interno del contenedor (5432).
# Las credenciales deben coincidir con las del .env de la raíz del repo.

DATABASE_URL=postgresql://training_life:training_life@localhost:5433/training_life
